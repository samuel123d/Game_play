rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Placar publico v2 do jogo web sem tela de login
    match /scores/{scoreId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasAll(['nickname', 'score', 'createdAt'])
        && request.resource.data.keys().hasOnly(['nickname', 'score', 'maxCombo', 'playerId', 'createdAt'])
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() > 0
        && request.resource.data.nickname.size() <= 20
        && request.resource.data.score is int
        && request.resource.data.score > 0
        && request.resource.data.score <= 1000000
        && (!request.resource.data.keys().hasAny(['maxCombo']) || (
          request.resource.data.maxCombo is int
          && request.resource.data.maxCombo >= 1
          && request.resource.data.maxCombo <= 8
        ))
        && (!request.resource.data.keys().hasAny(['playerId']) || (
          request.resource.data.playerId is string
          && request.resource.data.playerId.size() > 0
          && request.resource.data.playerId.size() <= 128
        ))
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
